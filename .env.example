# WagerProof Web App - Environment Variables
# Copy this file to .env and fill in values

# -----------------------------------------------------------
# Supabase — TWO instances, both required
# -----------------------------------------------------------
# Main: auth, user data, agents, AI completions, Polymarket cache
VITE_SUPABASE_URL=https://gnjrklxotmbvnxbnnqgq.supabase.co
VITE_SUPABASE_ANON_KEY=

# CFB: ALL sports predictions (NFL, CFB, NBA, NCAAB, MLB).
# Without these the app loads but every prediction surface is empty.
VITE_CFB_SUPABASE_URL=https://jpxnjuwglavsjbgbasnl.supabase.co
VITE_CFB_SUPABASE_ANON_KEY=

# Legacy aliases for the same CFB instance, still read by some modules
VITE_COLLEGE_FOOTBALL_SUPABASE_URL=
VITE_COLLEGE_FOOTBALL_SUPABASE_ANON_KEY=

# -----------------------------------------------------------
# Third-party (client-side)
# -----------------------------------------------------------
# Stripe (web payments)
VITE_STRIPE_PUBLISHABLE_KEY=

# The Odds API (real-time sportsbook odds)
VITE_THE_ODDS_API_KEY=

# Ghost CMS (blog content)
VITE_GHOST_URL=
VITE_GHOST_CONTENT_KEY=

# RevenueCat (web) — the integration IS live: `RevenueCatProvider` is mounted in
# src/App.tsx and src/services/revenuecatWeb.ts drives offerings, the custom paywall,
# and entitlement checks (useAccessControl, ProGate, useAgentEntitlements).
#
# There are deliberately no VITE_REVENUECAT_WEB_* entries here: the billing public keys
# are hardcoded in src/services/revenuecatWeb.ts:21-22 (`rcb_` keys are client-side
# publishable keys, not secrets). Setting the old VITE_REVENUECAT_WEB_PUBLIC_API_KEY /
# VITE_REVENUECAT_WEB_SANDBOX_API_KEY vars has no effect — nothing reads them.

# -----------------------------------------------------------
# Node scripts (prerender, blog/support build, data tooling)
# Unprefixed — these are NOT exposed to the browser.
# -----------------------------------------------------------
MAIN_SUPABASE_URL=
MAIN_SUPABASE_ANON_KEY=
CFB_SUPABASE_URL=
CFB_SUPABASE_ANON_KEY=
SITE_URL=
GHOST_URL=
GHOST_CONTENT_KEY=
GEMINI_API_KEY=
# Only needed by scripts that sign in as a real user to exercise RLS
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# -----------------------------------------------------------
# Edge Function Secrets (set via: supabase secrets set KEY=VALUE)
# Never committed — listed here so the required set is discoverable.
# -----------------------------------------------------------
# --- auto-injected by Supabase ---
# SUPABASE_URL                      - Main Supabase URL
# SUPABASE_SERVICE_ROLE_KEY         - Main service role key
# SUPABASE_ANON_KEY                 - Main anon key
#
# --- sports data ---
# CFB_SUPABASE_URL                  - CFB/sports predictions Supabase URL
# CFB_SUPABASE_ANON_KEY             - CFB instance anon key
# WAREHOUSE_URL                     - Analytics warehouse connection
# WAREHOUSE_SERVICE_KEY             - Analytics warehouse service key
#
# --- AI providers ---
# OPENAI_API_KEY                    - OpenAI (AI completions, WagerBot, V1 agent gen)
# DEEPSEEK_API_KEY                  - DeepSeek (V3 agent generation, default provider)
# GOOGLE_AI_API_KEY                 - Google Gemini
# TRENDS_OPENAI_API_KEY             - Separate OpenAI key for the NL filter/trends chat
#
# --- agent generation (V3 / Trigger.dev) ---
# TRIGGER_SECRET_KEY_PROD           - Trigger.dev prod secret; used by trigger-v3-run
#                                     and trigger-run-status. NOT a public access token.
#
# --- billing ---
# REVENUECAT_SECRET_API_KEY         - RevenueCat API access
# REVENUECAT_WEBHOOK_AUTH_HEADER    - Shared secret validating RevenueCat webhook calls
# REVENUECAT_ENTITLEMENT_IDENTIFIER - Entitlement id checked for Pro access
# STRIPE_SECRET_KEY                 - Stripe server-side
#
# --- ops / internal ---
# INTERNAL_FUNCTION_SECRET          - Inter-function auth (V2 agent queue)
# GRADE_CRON_SECRET                 - Guards the pick-grading cron endpoint
# BACKFILL_FUNCTION_SECRET          - Guards backfill-avatar-performance
# LOOPS_API_KEY                     - Loops email service
# FRONTEND_URL                      - Frontend URL for callbacks
# REACTIVATION_BATCH_SIZE           - Reactivation email batch size
# REACTIVATION_INACTIVITY_DAYS      - Days idle before a reactivation email
