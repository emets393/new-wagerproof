    <false/>
    <!-- ===== Meta / Facebook SDK =====
         These were `$(FACEBOOK_APP_ID)` / `$(FACEBOOK_CLIENT_TOKEN)` build settings
         that are defined NOWHERE in the repo (unlike Android, which injects them
         from CI secrets in android-native.yml). The result was an empty app ID at
         runtime, so the SDK never initialized and every Meta event was silently
         dropped. Neither value is a secret — the client token is exposed in the
         SDK's own network traffic and both already ship literal in the RN app
         (wagerproof-mobile/app.json) — so they are inlined here to remove the
         out-of-band injection step entirely. -->
    <key>FacebookAppID</key>
    <string>935005752525075</string>
    <key>FacebookClientToken</key>
    <string>bd008d0839f36a9941c0ed27d686b615</string>
    <key>FacebookDisplayName</key>
    <string>WagerProof</string>
    <!-- Auto-logging ON is what produces `fb_mobile_activate_app` — Meta's primary
         install-attribution signal. It was previously force-disabled in code, which
         meant Meta could never attribute an install. It does NOT double-count our
         explicit conversion events; RevenueCat's server-side integration dedupes on
         fb_order_id / fb_anon_id. -->
    <key>FacebookAutoLogAppEventsEnabled</key>
    <true/>
    <key>FacebookAdvertiserIDCollectionEnabled</key>
    <true/>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>fbapi</string>
        <string>fb-messenger-share-api</string>
        <string>fbauth2</string>
        <string>fbshareextension</string>
    </array>
